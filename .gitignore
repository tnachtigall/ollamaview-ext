# --- JetBrains IDEs (WebStorm, IntelliJ, etc.) ---
.idea/
# Specifically ensuring workspace.xml and other local-only files are ignored
# even if you decide to share some of the .idea folder later.
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/dictionary.xml
.idea/shelf/
.idea/tasks.xml
.idea/datasources/
.idea/jsLibraryMappings.xml
.idea/vcs.xml
*.iws

# --- Node.js / Standard JS ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
# Keep yarn.lock if you use yarn, but some prefer to ignore it (usually keep it)
# yarn.lock

# --- Build Outputs ---
dist/
build/
out/
.next/
.vuepress/dist/
.serverless/

# --- Environment Variables & Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# --- OS Junk ---
.DS_Store
Thumbs.db